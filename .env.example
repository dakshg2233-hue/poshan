# Poshan — environment template
#
# Copy this file to .env.local and fill in your own values:
#
#   cp .env.example .env.local
#
# .env.local is gitignored. Never commit real keys.
#
# Every variable here is optional to BOOT the app. Anything left blank simply
# switches its feature off — the route reports that it is not configured
# instead of crashing, so you can run the site with none of these set.


# --- Supabase ------------------------------------------------------------
# Powers sign-in (email OTP), profile, biomarkers, conditions, avatar upload.
# Project Settings > API in the Supabase dashboard.
# Without these, sign-in is inactive and nothing can be saved.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only. Bypasses row-level security — never expose it to the browser
# and never give it the NEXT_PUBLIC_ prefix.
SUPABASE_SERVICE_ROLE_KEY=


# --- Resend --------------------------------------------------------------
# Transactional email (one-time sign-in codes, notifications).
# resend.com/api-keys
RESEND_API_KEY=


# --- Anthropic -------------------------------------------------------------
# Powers both chatbots (Ask Poshan, Health Companion) at /api/chat.
# console.anthropic.com > API Keys. Without this, /api/chat returns "not
# configured" rather than pretending to answer.
ANTHROPIC_API_KEY=


# --- Razorpay ------------------------------------------------------------
# Checkout. Without these, /api/razorpay/subscription returns "not
# configured" rather than pretending a payment succeeded.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Verifies webhook signatures. Set this to the same secret you configure on
# the Razorpay webhook itself.
RAZORPAY_WEBHOOK_SECRET=

# Poshan Home's two Plans, created once in the Razorpay dashboard
# (Subscriptions > Plans) or via a one-off POST /v1/plans call — NOT created
# by this app at runtime. Paste each plan's id here once it exists.
RAZORPAY_PLAN_ID_MONTHLY=
RAZORPAY_PLAN_ID_YEARLY=


# --- Omniroute -----------------------------------------------------------
# Meal photo recognition. Without it, /api/scan asks the user to identify
# dishes by hand — the calorie count is exact either way.
OMNIROUTE_API_KEY=
OMNIROUTE_BASE_URL=
OMNIROUTE_VISION_MODEL=


# --- Web push ------------------------------------------------------------
# Browser push reminders ("log breakfast", weekly check-in). Not WhatsApp —
# sending over WhatsApp needs a Business API account and approved message
# templates this project doesn't have; this is the channel actually
# deliverable from here. Generate a keypair once with:
#   node -e "console.log(require('web-push').generateVAPIDKeys())"
# The public key is safe to expose to the browser (NEXT_PUBLIC_); the
# private key signs push messages and must stay server-only.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:support@example.com

# Shared secret /api/push/send checks for before sending anything — this
# route is meant to be hit by a scheduler (Vercel Cron, GitHub Actions, a
# server cron job), not by a browser, so it isn't gated by a user session.
# Nothing is scheduled to call it yet: wire your own cron to POST here with
# this header once you deploy (e.g. Authorization: Bearer <this value>).
PUSH_CRON_SECRET=


# --- Site ----------------------------------------------------------------
# Absolute origin, used for links in emails and for canonical URLs.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Analytics. Consent-gated — nothing loads until the visitor accepts.
# Leave blank to keep analytics off entirely.
NEXT_PUBLIC_ANALYTICS_ID=
