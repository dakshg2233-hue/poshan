# Copy to .env.local and fill in. .env* is gitignored — never commit real keys.
#
# RULE: only NEXT_PUBLIC_* variables reach the browser. Everything else stays
# on the server. If you ever prefix a secret with NEXT_PUBLIC_ it is baked into
# the JavaScript bundle and is public forever — rotate it immediately.

# ---------------------------------------------------------------- Supabase
# Safe in the browser. Protected by Row Level Security, so run supabase/schema.sql
# before going live — without RLS this key reads every row in every table.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# SERVER ONLY. Bypasses Row Level Security completely. Treat it like a database
# root password: never in client code, never in git, never in a bug report.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ---------------------------------------------------------------- Razorpay
# key_id is publishable and is sent to the browser to open checkout.
RAZORPAY_KEY_ID=rzp_test_xxxxxxxx
# SERVER ONLY. Signs orders and verifies payments. Anyone holding this can
# forge a valid payment signature.
RAZORPAY_KEY_SECRET=your-key-secret
# SERVER ONLY. Set in the Razorpay dashboard when you create the webhook.
RAZORPAY_WEBHOOK_SECRET=your-webhook-secret

# -------------------------------------------------------------- Resend
# SERVER ONLY. Email service for OTP codes, welcome emails, and confirmations.
# Sign up at https://resend.com — they provide a free plan for testing.
# Verify your domain or use the default noreply@resend.dev for testing.
RESEND_API_KEY=re_your_resend_api_key_here

# --------------------------------------------------------------- OmniRoute
# SERVER ONLY. Used by /api/scan for meal recognition, via OmniRoute's
# Anthropic-compatible endpoint. Billed per call, which is why that route is
# rate limited. Without this the scanner still works — it falls back to
# tapping dishes by hand, which gives an exact calorie count either way.
OMNIROUTE_API_KEY=sk-your-omniroute-key

# Optional overrides. Defaults shown.
# Only oc/mimo-v2.5-free is currently both vision-capable AND has live
# credentials on this OmniRoute instance — anthropic/openai providers have no
# credentials, and aug/* needs the Auggie CLI installed.
# OMNIROUTE_BASE_URL=http://localhost:20128
# OMNIROUTE_VISION_MODEL=oc/mimo-v2.5-free
